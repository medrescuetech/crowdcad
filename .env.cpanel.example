# Runtime variables for the cPanel Node.js application.
# Do not put passwords in Git.
NODE_ENV=production
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
DISABLE_TELEMETRY=true

# Optional: CrowdCAD contact form via cPanel/other SMTP
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=cad@example.com
SMTP_PASS=CHANGE_ME
CONTACT_FROM="CrowdCAD <cad@example.com>"
CONTACT_TO=admin@example.com
